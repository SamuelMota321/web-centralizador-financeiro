# Base URL da API do backend (contrato OpenAPI sob /api/v1).
# Local: suba o backend com `docker compose up` no repositorio backend-centralizador-financeiro.
# Se as portas foram remapeadas (compose.override.yaml), use http://localhost:3100/api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Auth0. Nunca colocar credenciais reais neste arquivo.
#
# Registre uma aplicacao do tipo "Regular Web Application" no Auth0 e configure nela:
#   Allowed Callback URLs:  http://localhost:3001/auth/callback
#   Allowed Logout URLs:    http://localhost:3001
#
# AUTH0_AUDIENCE deve ser identico ao do backend, senao o token e recusado.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
APP_BASE_URL=http://localhost:3001

# Chave de 32 bytes que cifra o cookie de sessao. Gere a sua com:
#   openssl rand -hex 32
AUTH0_SECRET=
